direction: down

classes: {
  entry: {}
  agent: {}
  swarm: { style.multiple: true }
  exit: {}
  stage: {}
  transition: { style.stroke-dash: 4 }
  back: { style.stroke-dash: 4 }
  handover: {}
}

orchestrator: {
  class: entry
  tooltip: talks to you
  on-call: {
    design: { class: agent; tooltip: interviews the user }
  }
}

step1: {
  label: step 1
  clarify: {
    class: stage
    tooltip: until nothing is open
    functionality: { class: agent; tooltip: interviews the user }
  }
}

step2: {
  label: step 2
  research: { class: stage; tooltip: stack, commands, hazards }
}

step3: {
  label: step 3
  plan: { class: stage; tooltip: tasks, rubric, harness }
}

step4: {
  label: step 4
  implement: {
    class: stage
    tooltip: build in parallel
    worker: { class: swarm; tooltip: builds one task }
  }
}

step5: {
  label: step 5
  qa: {
    class: stage
    tooltip: as the end user
    qa: { class: agent; tooltip: judges as the user }
    qa-collector: { class: swarm; tooltip: gathers evidence }
  }
}

step6: {
  label: step 6
  merge: { class: stage; tooltip: integrate the run }
}

done: { class: exit; tooltip: the run ends }

orchestrator -> step1: handed over { class: transition }
step1 -> step2: nothing open { class: transition }
step2 -> step3: findings noted { class: transition }
step3 -> step4: plan shown { class: transition }
step4 -> step5: all landed { class: transition }
step5 -> step6: all pass { class: transition }
step5 -> step4: fix { class: back }
step6 -> step4: reconcile { class: back }
step6 -> done: integrated { class: transition }

orchestrator -> step4.implement.worker: brief { class: handover }
step4.implement.worker -> orchestrator: report { class: handover }
orchestrator -> step5.qa.qa: judge { class: handover }
step5.qa.qa -> orchestrator: scored report { class: handover }
step5.qa.qa -> step5.qa.qa-collector: slice { class: handover }
step5.qa.qa-collector -> step5.qa.qa: evidence { class: handover }
